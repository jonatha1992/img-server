# Una API key por proyecto: API_KEY_<NOMBRE_EN_MAYUSCULAS>. El proyecto en la URL es el nombre en minúsculas.
API_KEY_SHOWROOMISABELLA=
# Orígenes extra permitidos por CORS (separados por coma). *.tecnofusion.dev y localhost ya están permitidos.
CORS_ORIGINS=
# Solo desarrollo local (en prod lo fija docker-compose)
PUBLIC_URL=http://localhost:3000
DATA_DIR=./data
PORT=3000
